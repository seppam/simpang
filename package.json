{
  "name": "simpang",
  "version": "0.1.0",
  "private": true,
  "description": "A small governed inference gateway: one path to many LLM providers, with routing, metering and evaluation.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "migrate": "node --env-file-if-exists=.env src/db/migrate-cli.ts",
    "create-key": "node --env-file-if-exists=.env src/db/create-key-cli.ts"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

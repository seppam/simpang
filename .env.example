# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Put each value right after "=", on the same line, with no spaces or quotes.
DATABASE_URL=postgres://simpang:simpang@localhost:5433/simpang

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional providers: each one switches on when its key/URL is set.
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ":free" models cost nothing: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Hugging Face Inference Providers: https://huggingface.co/settings/tokens
HF_TOKEN=
# Paid; the adapter is tested with fakes only
ANTHROPIC_API_KEY=
# Self-hosted, e.g. http://localhost:11434
OLLAMA_BASE_URL=
